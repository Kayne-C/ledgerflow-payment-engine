{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=localhost,1433;Database=LedgerFlow;User Id=sa;Password=Your_strong_password1;TrustServerCertificate=True"
  },
  "Messaging": {
    "Transport": "Kafka",
    "ConsumersEnabled": true,
    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "Partitions": 24,
      "ConsumersPerProcess": 4
    },
    "Outbox": { "Enabled": true },
    "Sweeper": { "Enabled": true }
  },
  "Risk": {
    "Mode": "Grpc",
    "Address": "http://localhost:5091"
  }
}
